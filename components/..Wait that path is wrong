"use client";

import type { ToolbarOptionDef } from "../types";

const COLORS = [
  { label: "Ink", value: "#1e293b" },
  { label: "Gray", value: "#64748b" },
  { label: "Red", value: "#b91c1c" },
  { label: "Orange", value: "#c2410c" },
  { label: "Green", value: "#15803d" },
  { label: "Blue", value: "#1d4ed8" },
  { label: "Teal", value: "#0f766e" },
];

const FONT_SIZES = [
  { label: "S", value: "sm" as const },
  { label: "M", value: "md" as const },
  { label: "L", value: "lg" as const },
  { label: "XL", value: "xl" as const },
];

function ToggleBtn({
  active,
  label,
  title,
  onClick,
  disabled,
}: {
  active: boolean;
  label: string;
  title: string;
  onClick: () => void;
  disabled?: boolean;
}) {
  return (
    <button
      type="button"
      title={title}
      aria-label={title}
      aria-pressed={active}
      disabled={disabled}
      onMouseDown={(e) => e.preventDefault()}
      onClick={onClick}
      className={`rounded px-2 py-1 text-xs font-medium transition disabled:opacity-40 ${
        active
          ? "bg-slate-900 text-white"
          : "text-slate-600 hover:bg-slate-100"
      }`}
    >
      {label}
    </button>
  );
}

/**
 * Text formatting options — apply to the current text selection only
 * via the active contentEditable editor (not the whole block).
 */
export const textFormatOptions: ToolbarOptionDef[] = [
  {
    id: "bold",
    label: "Bold",
    render: ({ inline }) => (
      <ToggleBtn
        active={inline.state.bold}
        label="B"
        title="Bold selection"
        disabled={!inline.available}
        onClick={inline.toggleBold}
      />
    ),
  },
  {
    id: "italic",
    label: "Italic",
    render: ({ inline }) => (
      <ToggleBtn
        active={inline.state.italic}
        label="I"
        title="Italic selection"
        disabled={!inline.available}
        onClick={inline.toggleItalic}
      />
    ),
  },
  {
    id: "underline",
    label: "Underline",
    render: ({ inline }) => (
      <ToggleBtn
        active={inline.state.underline}
        label="U"
        title="Underline selection"
        disabled={!inline.available}
        onClick={inline.toggleUnderline}
      />
    ),
  },
  {
    id: "fontSize",
    label: "Size",
    render: ({ inline }) => (
      <div className="flex items-center gap-0.5 rounded border border-slate-200 bg-white p-0.5">
        {FONT_SIZES.map((size) => (
          <button
            key={size.value}
            type="button"
            title={`Size ${size.label} (selection)`}
            disabled={!inline.available}
            onMouseDown={(e) => e.preventDefault()}
            onClick={() => inline.setFontSize(size.value)}
            className={`rounded px-1.5 py-0.5 text-[11px] disabled:opacity-40 ${
              inline.state.fontSize === size.value
                ? "bg-slate-900 text-white"
                : "text-slate-600 hover:bg-slate-50"
            }`}
          >
            {size.label}
          </button>
        ))}
      </div>
    ),
  },
  {
    id: "textColor",
    label: "Color",
    render: ({ inline }) => (
      <div className="flex items-center gap-1">
        <span className="text-[11px] text-slate-400">Color</span>
        <div className="flex items-center gap-1">
          {COLORS.map((color) => (
            <button
              key={color.value}
              type="button"
              title={`${color.label} (selection)`}
              disabled={!inline.available}
              onMouseDown={(e) => e.preventDefault()}
              onClick={() => inline.setColor(color.value)}
              className={`h-4 w-4 rounded-full border disabled:opacity-40 ${
                inline.state.color &&
                rgbClose(inline.state.color, color.value)
                  ? "border-slate-900 ring-1 ring-slate-400"
                  : "border-slate-200"
              }`}
              style={{ backgroundColor: color.value }}
            />
          ))}
        </div>
      </div>
    ),
  },
];

function rgbClose(computed: string, hex: string): boolean {
  const probe = document.createElement("span");
  probe.style.color = hex;
  document.body.appendChild(probe);
  const target = getComputedStyle(probe).color;
  document.body.removeChild(probe);
  return computed === target;
}
